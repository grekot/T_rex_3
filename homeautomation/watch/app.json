{
  "configVersion": "v3",
  "app": {
    "appId": 1087170,
    "appName": "Dom",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "grekot",
    "description": "Dom - podglad i sterowanie urzadzeniami domowymi (termostat, swiatla) przez chmure"
  },
  "permissions": [
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/thermostat/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Dom"
    },
    "pl-PL": {
      "appName": "Dom"
    }
  },
  "defaultLanguage": "en-US"
}
