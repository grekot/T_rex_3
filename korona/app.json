{
  "configVersion": "v3",
  "app": {
    "appId": 1087166,
    "appName": "Korona",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "grekot",
    "description": "Korona Gor Polski - zegarek rozpoznaje szczyt i zapisuje zdobycie z data"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.geolocation",
    "device:os.compass"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/peak/index.page",
            "page/gt/date/index.page",
            "page/gt/nearest/index.page"
          ]
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Peak Crown"
    },
    "pl-PL": {
      "appName": "Korona"
    }
  },
  "defaultLanguage": "en-US"
}
