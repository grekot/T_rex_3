    "version": {
      "code": 4,
      "name": "1.2.0"
    },
    "icon": "icon.png",
    "vender": "grekot",
    "description": "Liczba subskrybentow kanalu YouTube na Amazfit T-Rex 3"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
