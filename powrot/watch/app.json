{
  "configVersion": "v3",
  "app": {
    "appId": 1087160,
    "appName": "Powrot",
    "appType": "app",
    "version": {
      "code": 2,
      "name": "1.1.0"
    },
    "icon": "icon.png",
    "vender": "grekot",
    "description": "Zapisz miejsce (parking, namiot) i wroc do niego ze strzalka kompasu"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.geolocation",
    "device:os.compass"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/save/index.page",
            "page/gt/navigate/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Back to spot"
    },
    "pl-PL": {
      "appName": "Powrót"
    }
  },
  "defaultLanguage": "en-US"
}
