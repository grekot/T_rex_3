{
  "configVersion": "v3",
  "app": {
    "appId": 1087158,
    "appName": "Zakupy",
    "appType": "app",
    "version": {
      "code": 3,
      "name": "1.2.0"
    },
    "icon": "icon.png",
    "vender": "grekot",
    "description": "Lista zakupow z telefonu - odhaczanie na Amazfit T-Rex 3"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/list/index.page",
            "page/gt/add/index.page",
            "page/gt/settings/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Shopping"
    },
    "pl-PL": {
      "appName": "Zakupy"
    }
  },
  "defaultLanguage": "en-US"
