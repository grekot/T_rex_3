rules_version = '2';

// UWAGA: Firestore ma jeden zestaw reguł na bazę. Od czasu Sklepu rodzinnego PUBLIKUJ
// App_storage/firebase/firestore.rules (ten plik + bloki sklepu, z testami na emulatorze).
// Zmiany reguł Zakupów/Powrotu wprowadzaj tam, inaczej publikacja tego pliku wyłączy sklep.

// Lista zakupów:
//   lists/{listId}                 listy (members = uid osób z dostępem, ownerId = właściciel)
//   lists/{listId}/items/{itemId}  produkty
//   emails/{email}                 e-mail -> uid (do dodawania znajomych po e-mailu)
//   users/{uid}/friends/{uid}      znajomi danej osoby
//   places/{placeId}               zapisane miejsca z aplikacji Powrót (np. gdzie stoi auto)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(listId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
    }

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function validPlace(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lon is number && data.lon >= -180 && data.lon <= 180;
    }

    // Zmiana osób z dostępem - te same zasady dla list i miejsc:
    //  - właściciel może wszystko (także usuwać osoby), ale nie może zniknąć z dokumentu,
    //  - pozostali mogą tylko dopisywać osoby albo usunąć samych siebie (opuścić).
    function validMembersChange() {
      return request.auth.uid in resource.data.members
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.ownerId in request.resource.data.members
        && (
          request.auth.uid == resource.data.ownerId
          || request.resource.data.members.hasAll(resource.data.members)
          || request.resource.data.members.toSet()
               == resource.data.members.toSet().difference([request.auth.uid].toSet())
        );
    }

    match /places/{placeId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && validPlace(request.resource.data);
      allow update: if signedIn() && validMembersChange() && validPlace(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Książka adresowa: można odczytać tylko pojedynczy wpis znając dokładny e-mail
    // (bez przeglądania listy kont). Każdy zapisuje wyłącznie własny e-mail.
    match /emails/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Znajomi - widzi i zmienia tylko właściciel
    match /users/{uid}/friends/{friendUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /lists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && validName(request.resource.data);

      // Zmiany listy (nazwa, udostępnianie):
      //  - właściciel może wszystko (także usuwać osoby), ale nie może zniknąć z listy,
      //  - pozostali mogą tylko dopisywać osoby albo usunąć z listy samych siebie (opuścić ją).
      allow update: if signedIn() && validMembersChange() && validName(request.resource.data);

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /items/{itemId} {
        allow read, delete: if isMember(listId);
        allow create, update: if isMember(listId)
          && validName(request.resource.data)
          && request.resource.data.checked is bool;
      }
    }
  }
}
