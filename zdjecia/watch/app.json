{
  "configVersion": "v3",
  "app": {
    "appId": 1087163,
    "appName": "Zdjecia",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "grekot",
    "description": "Najciekawsze zdjecia z galerii telefonu na zegarku (etap probny: przesyl i pomiary)"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage", "device:os.ble"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": ["page/gt/home/index.page"]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Photos"
    },
    "pl-PL": {
      "appName": "Zdjęcia"
    }
  },
  "defaultLanguage": "en-US"
}
